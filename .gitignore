.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python local artifacts
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.rar

# Local archives and reports
*.zip
git-review.txt
